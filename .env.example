# Salin jadi .env untuk lokal, atau isi nilai aslinya di tab Environment Dokploy.
# Semua baris komentar harus berdiri sendiri (tanpa komentar inline setelah nilai).

# ---------- Database ----------
MYSQL_ROOT_PASSWORD=ganti-root-password-kuat
DB_USER=tidur_app
DB_PASS=ganti-password-app-kuat

# ---------- Akun awal (install.php) ----------
INSTALL_ADMIN_USERNAME=admin
INSTALL_ADMIN_PASSWORD=ganti-password-admin-kuat
INSTALL_VIEWER_USERNAME=viewer
INSTALL_VIEWER_PASSWORD=ganti-password-viewer-kuat

# ---------- Runtime web ----------
APP_DEBUG=0
APP_FORCE_HTTPS=1
APP_BEHIND_PROXY=1
